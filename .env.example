# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=bugfinder
MONGO_PASSWORD=password123
MONGO_DB=bugfinder
MONGODB_URI=mongodb://bugfinder:password123@localhost:27017/bugfinder?authSource=admin

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production-use-long-random-string

# ── OpenCode / OpenAI ─────────────────────────────────────────────────────────
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_API_BASE=https://opencode.ai/zen/v1
OPENCODE_MODEL=nemotron-3-super-free

# AI token budget per user per day (estimated tokens, ~4 chars/token)
AI_DAILY_TOKEN_BUDGET=50000

# Data retention: audit logs TTL in days (default 365)
DATA_RETENTION_DAYS=365

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SMTP (email alerts & scheduled reports) ───────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@bugfinder.io
ADMIN_EMAIL=admin@bugfinder.local

# ── SAML 2.0 SSO ─────────────────────────────────────────────────────────────
SAML_ENTRY_POINT=https://your-idp.com/saml/sso
SAML_CALLBACK_URL=https://your-app.com/api/auth/saml/callback
SAML_ISSUER=bugfinder
# Base64-encoded X.509 certificate from your IdP
SAML_IDP_CERT=
# PEM-encoded SP private key (optional, for signed AuthnRequests)
SAML_PRIVATE_KEY=

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Bug Finder
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ── OAuth (GitHub / Google OIDC) ─────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:5000/api/auth/oidc/callback

# ── Vault / Secrets Management ───────────────────────────────────────────────
# HashiCorp Vault (preferred)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/bugfinder

# AWS Secrets Manager (fallback if Vault is unavailable)
AWS_REGION=us-east-1
AWS_SECRET_ID=bugfinder/production

# ── Multi-Tenant ─────────────────────────────────────────────────────────────
MULTI_TENANT=false

# ── Integrations ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_DEFAULT_CHANNEL=#security-alerts
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Scanner Infrastructure ────────────────────────────────────────────────────
ZAP_URL=http://localhost:8090
PLAYWRIGHT_URL=http://localhost:3005
INTERACTSH_URL=http://localhost:8194
INTERACTSH_TOKEN=changeme
INTERACTSH_DOMAIN=oast.local

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# ── TLS / nginx (production) ─────────────────────────────────────────────────
TLS_CERT_PATH=/etc/ssl/certs/bugfinder.crt
TLS_KEY_PATH=/etc/ssl/private/bugfinder.key
DOMAIN=bugfinder.example.com
